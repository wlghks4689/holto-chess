{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porena",
  "account_id": "0a1102b704cf75e79300017e1904fe7e",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "routes": [
    { "pattern": "porena.kr", "custom_domain": true },
    { "pattern": "www.porena.kr", "custom_domain": true },
    { "pattern": "admin.porena.kr", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    // The Worker serves the app shell for page navigations only (worker/index.ts). A missing file under /assets/
    // must stay a 404: an SPA fallback there returned index.html under the year-long immutable JS cache rule.
    "not_found_handling": "none",
    // Every page request reaches the Worker so admin.porena.kr never falls back to the game's index.html.
    // Hashed bundles (/assets/*.js|css at the folder root) also pass through it: _headers marks that path immutable
    // even on a 404, so the Worker turns a missing chunk into an uncacheable 404. Media folders are served directly.
    "run_worker_first": ["/*", "!/assets/abilities/*", "!/assets/audio/*", "!/assets/brand/*", "!/assets/draft/*", "!/assets/final/*", "!/assets/start/*", "!/assets/table/*", "!/favicon-32.png", "!/favicon-192.webp", "!/apple-touch-icon.png"]
  },
  // 03:00 KST daily: deletes feedback older than 90 days and clears reply emails of archived messages (worker/retention.ts).
  "triggers": { "crons": ["0 18 * * *"] },
  "d1_databases": [
    { "binding": "FEEDBACK_DB", "database_name": "porena-feedback", "database_id": "26ec86c4-3904-4eab-8a76-09e3261757dc", "migrations_dir": "migrations" },
    { "binding": "ACCOUNT_DB", "database_name": "porena-account", "database_id": "e4eedbce-2157-4823-b840-eec1017d4f60", "migrations_dir": "account-migrations" }
  ],
  "vars": {
    // Discord Activity: comma-separated Discord application ids whose https://<id>.discordsays.com origin may
    // call /api/* and /ws/* (exact match, worker/origin.ts). Empty = porena.kr only. Public ids, not secrets.
    "DISCORD_ACTIVITY_CLIENT_IDS": "1555427351829942353",
    "AUTH_ORIGIN": "https://porena.kr",
    "GOOGLE_CLIENT_ID": ""
  },
  // Set with tools/admin/setup-admin.mjs. Never commit their values.
  "secrets": { "required": ["ADMIN_USERNAME", "ADMIN_PASSWORD_HASH", "ADMIN_SESSION_SECRET", "GOOGLE_CLIENT_SECRET"] },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "observability": {
    "enabled": true,
    // OAuth callback carries a one-use code/state in its URL; exclude query strings from logs/traces.
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "ratelimits": [
    { "name": "ROOM_CREATE_LIMITER", "namespace_id": "2026091901", "simple": { "limit": 10, "period": 60 } },
    { "name": "ROOM_CONNECT_LIMITER", "namespace_id": "2026091902", "simple": { "limit": 120, "period": 60 } },
    { "name": "FEEDBACK_LIMITER", "namespace_id": "2026093001", "simple": { "limit": 3, "period": 60 } },
    { "name": "ADMIN_LOGIN_LIMITER", "namespace_id": "2026093002", "simple": { "limit": 5, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "2026100701", "simple": { "limit": 10, "period": 60 } }
  ],
  "exports": {
    "GameRoom": { "type": "durable-object", "storage": "sqlite" }
  }
}
