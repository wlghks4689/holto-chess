{
  "name": "holto-chess-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Delegating workspace root for PORENA. The application lives in holto-chess/.",
  "scripts": {
    "postinstall": "npm --prefix holto-chess install",
    "dev": "npm --prefix holto-chess run dev --",
    "build": "npm --prefix holto-chess run build",
    "preview": "npm --prefix holto-chess run preview",
    "deploy": "npm --prefix holto-chess run deploy",
    "test": "npm --prefix holto-chess test",
    "test:workers": "npm --prefix holto-chess run test:workers",
    "lint": "npm --prefix holto-chess run lint"
  }
}
